# ── Images (built by GitHub Actions → ghcr.io). latest = main; or pin a release, e.g. AFATURA_IMAGE_TAG=1.2.0 ──
AFATURA_IMAGE_PREFIX=ghcr.io/avunity/a-fatura
AFATURA_IMAGE_TAG=latest
# GHCR access with the GitHub App (Packages: Read). Empty → uses an existing `docker login ghcr.io` (PAT).
GH_APP_ID=
GH_APP_KEY=/etc/a-fatura/github-app.pem
GH_APP_INSTALLATION_ID=

# ── Domain ──
PUBLIC_HOST=fatura.avunity.com
WEB_PORT=8095

# ── Secrets (generate with: openssl rand -base64 48) ──
DB_PASSWORD=change-me
JWT_KEY=change-me-to-a-long-random-string-with-at-least-32-chars

# First backoffice user (created on first start if it doesn't exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_SELF_REGISTRATION=true

# ── AI extraction ──
# ClaudeCli = uses the Claude CLI logged in on the VPS (mounted below) · Anthropic = API key · None = QR code only
AI_PROVIDER=ClaudeCli
AI_MODEL=
ANTHROPIC_API_KEY=
INSTALL_CLAUDE_CLI=true
# uid of the VPS user that owns the Claude login (id -u), and where that login lives (applied at runtime)
APP_UID=1000
CLAUDE_HOME=/root/.claude
CLAUDE_JSON=/root/.claude.json

# ── Inbound e-mail (per-collaborator addresses token@MAIL_INBOUND_DOMAIN) ──
MAIL_INBOUND_DOMAIN=in.fatura.avunity.com
# Option A: provider webhook → POST https://PUBLIC_HOST/api/inbound/email?key=MAIL_WEBHOOK_SECRET (raw MIME)
MAIL_WEBHOOK_SECRET=
# Option C (recommended when DNS is not on Cloudflare, e.g. amen.pt): built-in SMTP receiver.
#   DNS: MX in.fatura → fatura.avunity.com (priority 10); open port 25/tcp on the VPS firewall.
#   Also uncomment COMPOSE_FILE so the port 25 mapping (deploy/docker-compose.smtp.yml) is always applied.
SMTP_ENABLED=false
SMTP_PUBLIC_PORT=25
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.smtp.yml
# Option B: catch-all IMAP mailbox polled every minute
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
